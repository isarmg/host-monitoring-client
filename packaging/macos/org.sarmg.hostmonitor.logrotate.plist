<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>org.sarmg.hostmonitor.logrotate</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/libexec/host-monitor-logrotate</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>3600</integer>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>/var/log/host-monitor.log</string>
  <key>StandardErrorPath</key><string>/var/log/host-monitor.log</string>
</dict>
</plist>
