[Unit]
Description=xsoc read-only host telemetry client for xsos
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
TimeoutStartSec=30s
User=xsoc
Group=xsoc
ExecStart=/usr/bin/xsoc run --config /etc/xsoc/config.json
Restart=on-failure
RestartSec=10s

# StateDirectory stores current pairing state, per-host tokens and spool; it must be 0700.
# Without an explicit mode, systemd uses 0755 and resets it on each start. The client accepts only
# secure existing private directories and does not repair permissions at runtime. Match xsos.service.
StateDirectory=xsoc
StateDirectoryMode=0700
ConfigurationDirectory=xsoc
ConfigurationDirectoryMode=0750
UMask=0077

NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# Match xsos.service. sysinfo needs AF_NETLINK to enumerate interfaces; removing it loses network metrics.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallFilter=@system-service
ReadWritePaths=/var/lib/xsoc

[Install]
WantedBy=multi-user.target
