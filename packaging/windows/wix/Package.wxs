<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package
    UpgradeCode="B4A341EC-D4B2-419F-A00B-E8E504DE9798"
    Name="host-monitor"
    Manufacturer="Host Monitoring"
    Version="$(var.ProductVersion)"
    Language="1033"
    Codepage="1252"
    Scope="perMachine"
    InstallerVersion="500"
    Compressed="yes">

    <SummaryInformation
      Description="Host Monitoring read-only host telemetry client"
      Keywords="Host Monitoring,client,telemetry,service"
      Manufacturer="Host Monitoring" />
    <MajorUpgrade DowngradeErrorMessage="A newer host-monitor version is installed." Schedule="afterInstallInitialize" />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Launch
      Condition="VersionNT64"
      Message="[ProductName] requires 64-bit Windows." />
    <!-- ACL and state changes are explicitly transactional; never run without rollback. -->
    <Launch
      Condition="NOT RollbackDisabled"
      Message="[ProductName] setup requires Windows Installer rollback to remain enabled." />
    <Launch
      Condition="NOT PURGE OR PURGE = &quot;1&quot;"
      Message="PURGE accepts only the value 1. Omit it for a state-preserving uninstall." />
    <Launch
      Condition="NOT HOST_MONITORING_MAINTENANCE_DIAGNOSTICS OR HOST_MONITORING_MAINTENANCE_DIAGNOSTICS = &quot;1&quot;"
      Message="HOST_MONITORING_MAINTENANCE_DIAGNOSTICS accepts only the value 1. Omit it to disable maintenance diagnostics." />

    <Property Id="ARPCONTACT" Value="Host Monitoring maintainers" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/isarmg/host-monitoring-client" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="PURGE" Secure="yes" />
    <Property Id="HOST_MONITORING_MAINTENANCE_DIAGNOSTICS" Value="1" Secure="yes" />
    <!-- Formatted only after costing; the WiX helper launches it with Explorer's normal token. -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="host-monitor" />
    </StandardDirectory>
    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="STATEDIRECTORY" Name="host-monitor" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <DirectoryRef Id="INSTALLFOLDER">
      <Component
        Id="ClientServiceComponent"
        Guid="{C7D313C7-1B72-4826-8FA4-5BF10928349E}"
        Bitness="always64">
        <File
          Id="ClientExecutable"
          Source="$(var.ClientExe)"
          Name="host-monitor.exe"
          KeyPath="yes"
          Checksum="yes" />

        <!-- Remove only this product's registered legacy UI entries. -->
        <RemoveRegistryValue Id="RemoveLegacyTrayRun" Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="host-monitor-tray" />
        <RemoveFile Id="RemoveLegacyTrayFile" Name="host-monitor-tray.exe" On="install" />
        <RemoveFile Id="RemoveLegacyTrayShortcut" Directory="ProgramMenuFolder" Name="host-monitor.lnk" On="install" />

        <ServiceInstall
          Id="HostMonitorServiceInstall"
          Name="host-monitor"
          DisplayName="host-monitor"
          Description="Collects and securely reports read-only host telemetry to Host Monitoring."
          Type="ownProcess"
          Start="demand"
          ErrorControl="normal"
          Account="NT AUTHORITY\LocalService"
          Arguments="--windows-service run --config &quot;[CommonAppDataFolder]host-monitor\config.json&quot;"
          Vital="yes">
          <util:ServiceConfig
            FirstFailureActionType="restart"
            SecondFailureActionType="restart"
            ThirdFailureActionType="restart"
            RestartServiceDelayInSeconds="60"
            ResetPeriodInDays="1" />
        </ServiceInstall>
        <ServiceControl
          Id="HostMonitorServiceControl"
          Name="host-monitor"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      </Component>
    </DirectoryRef>

    <!--
      This component records the fixed mutable root but deliberately creates or owns neither the
      directory nor any runtime file below it. The transactional native helper creates and secures
      the directory before StartServices. Windows Installer therefore cannot recreate it between
      purge quarantine and rollback, and preserves config, identity, credentials and spool on an
      ordinary uninstall.
    -->
    <DirectoryRef Id="STATEDIRECTORY">
      <Component
        Id="ClientStateDirectoryComponent"
        Guid="{55346DF8-69D2-425D-B574-F80379CB87A2}"
        Bitness="always64">
        <RegistryValue
          Root="HKLM"
          Key="Software\Host Monitoring\host-monitor"
          Name="ManagedStateDirectory"
          Type="string"
          Value="[STATEDIRECTORY]"
          KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature
      Id="ClientFeature"
      Title="host-monitor"
      Level="1"
      AllowAbsent="no"
      AllowAdvertise="no">
      <ComponentRef Id="ClientServiceComponent" />
      <ComponentRef Id="ClientStateDirectoryComponent" />
    </Feature>



    <!-- The same helper is embedded once and is never left behind as another utility. -->
    <Binary Id="HostMonitorMaintenance.exe" SourceFile="$(var.MaintenanceExe)" />

    <!--
      A normal MSI invocation has an interactive terminal available to the
      installed console executable. Start the first-run setup only after the
      transactional install has committed; silent/automation invocations keep
      the installation intact and can resume through the CLI later.
    -->
    <CustomAction
      Id="LaunchInteractiveSetup"
      FileRef="ClientExecutable"
      ExeCommand="setup --interactive"
      Execute="immediate"
      Impersonate="yes"
      Return="ignore" />

    <CustomAction
      Id="RollbackClientInstall"
      BinaryRef="HostMonitorMaintenance.exe"
      ExeCommand="rollback-install [HOST_MONITORING_MAINTENANCE_DIAGNOSTICS]"
      Execute="rollback"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="PrepareClientInstall"
      BinaryRef="HostMonitorMaintenance.exe"
      ExeCommand="prepare-install [HOST_MONITORING_MAINTENANCE_DIAGNOSTICS]"
      Execute="deferred"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="ApplyClientInstall"
      BinaryRef="HostMonitorMaintenance.exe"
      ExeCommand="apply-install [HOST_MONITORING_MAINTENANCE_DIAGNOSTICS]"
      Execute="deferred"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="CommitClientInstall"
      BinaryRef="HostMonitorMaintenance.exe"
      ExeCommand="commit-install [HOST_MONITORING_MAINTENANCE_DIAGNOSTICS]"
      Execute="commit"
      Impersonate="no"
      Return="ignore" />

    <CustomAction
      Id="RollbackUninstallPreflight"
      BinaryRef="HostMonitorMaintenance.exe"
      ExeCommand="rollback-uninstall-preflight [HOST_MONITORING_MAINTENANCE_DIAGNOSTICS]"
      Execute="rollback"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="PreflightClientUninstall"
      BinaryRef="HostMonitorMaintenance.exe"
      ExeCommand="preflight-uninstall [HOST_MONITORING_MAINTENANCE_DIAGNOSTICS]"
      Execute="deferred"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="RollbackPreservedState"
      BinaryRef="HostMonitorMaintenance.exe"
      ExeCommand="rollback-uninstall [HOST_MONITORING_MAINTENANCE_DIAGNOSTICS]"
      Execute="rollback"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="PreserveClientState"
      BinaryRef="HostMonitorMaintenance.exe"
      ExeCommand="preserve-state [HOST_MONITORING_MAINTENANCE_DIAGNOSTICS]"
      Execute="deferred"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="CommitPreservedState"
      BinaryRef="HostMonitorMaintenance.exe"
      ExeCommand="commit-uninstall [HOST_MONITORING_MAINTENANCE_DIAGNOSTICS]"
      Execute="commit"
      Impersonate="no"
      Return="ignore" />
    <CustomAction
      Id="RollbackPurgedState"
      BinaryRef="HostMonitorMaintenance.exe"
      ExeCommand="rollback-purge [HOST_MONITORING_MAINTENANCE_DIAGNOSTICS]"
      Execute="rollback"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="PreparePurgedState"
      BinaryRef="HostMonitorMaintenance.exe"
      ExeCommand="prepare-purge [HOST_MONITORING_MAINTENANCE_DIAGNOSTICS]"
      Execute="deferred"
      Impersonate="no"
      Return="check" />
    <CustomAction
      Id="CommitPurgedState"
      BinaryRef="HostMonitorMaintenance.exe"
      ExeCommand="commit-purge [HOST_MONITORING_MAINTENANCE_DIAGNOSTICS]"
      Execute="commit"
      Impersonate="no"
      Return="ignore" />



    <InstallExecuteSequence>


      <!--
        Register rollback, then snapshot current state before Windows Installer reaches
        StopServices. This captures the managed service's running state before repair changes it,
        and is also earlier than directory/file installation.
        REMOVE is reliable only after InstallValidate; every action below is later.
      -->
      <Custom
        Action="RollbackClientInstall"
        Before="PrepareClientInstall"
        Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom
        Action="PrepareClientInstall"
        Before="StopServices"
        Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom
        Action="ApplyClientInstall"
        After="InstallServices"
        Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom
        Action="CommitClientInstall"
        After="ApplyClientInstall"
        Condition="NOT REMOVE~=&quot;ALL&quot;" />
      <Custom
        Action="LaunchInteractiveSetup"
        After="InstallFinalize"
        Condition="NOT Installed AND NOT REMOVE~=&quot;ALL&quot; AND UILevel &gt;= 4" />

      <!--
        Standard MSI service/file removal is name/path based, so it must never run until the
        helper has rejected a replaced service and file/junction/reparse root. Register a narrow
        preflight rollback first so a preflight failure can remove its journal. State rollback is
        deliberately registered only after StopServices: reverse execution then restores the MSI
        service before the helper restores state ACLs, SID settings and prior running state.
      -->
      <Custom
        Action="RollbackUninstallPreflight"
        Before="PreflightClientUninstall"
        Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom
        Action="PreflightClientUninstall"
        Before="StopServices"
        Condition="REMOVE~=&quot;ALL&quot;" />
      <Custom
        Action="RollbackPreservedState"
        After="StopServices"
        Condition="REMOVE~=&quot;ALL&quot; AND NOT (PURGE = &quot;1&quot;)" />
      <Custom
        Action="PreserveClientState"
        After="RollbackPreservedState"
        Condition="REMOVE~=&quot;ALL&quot; AND NOT (PURGE = &quot;1&quot;)" />
      <Custom
        Action="CommitPreservedState"
        After="PreserveClientState"
        Condition="REMOVE~=&quot;ALL&quot; AND NOT (PURGE = &quot;1&quot;)" />

      <!--
        Purge first performs a full no-reparse scan and atomically quarantines the state root.
        Rollback can restore that rename until the transaction reaches commit. Commit deletion is
        irreversible: if it cannot finish, the protected quarantine may remain for explicit
        administrator cleanup, but Windows Installer must not roll an already uninstalled product
        back onto a partially deleted state tree.
        Major upgrades preserve state through the ordinary uninstall path.
      -->
      <Custom
        Action="RollbackPurgedState"
        After="StopServices"
        Condition="REMOVE~=&quot;ALL&quot; AND PURGE = &quot;1&quot;" />
      <Custom
        Action="PreparePurgedState"
        After="RollbackPurgedState"
        Condition="REMOVE~=&quot;ALL&quot; AND PURGE = &quot;1&quot;" />
      <Custom
        Action="CommitPurgedState"
        After="PreparePurgedState"
        Condition="REMOVE~=&quot;ALL&quot; AND PURGE = &quot;1&quot;" />
    </InstallExecuteSequence>
  </Package>
</Wix>
